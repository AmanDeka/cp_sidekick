{
  "manifest_version": 3,
  "name": "CP Sidekick Companion",
  "version": "1.3.0",
  "description": "Send Codeforces problems and sessions to VS Code with one click.",
  "permissions": ["activeTab", "scripting", "cookies", "tabs", "storage"],
  "host_permissions": ["*://*.codeforces.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CP Sidekick"
  }
}
